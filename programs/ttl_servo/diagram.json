{
  "version": 1,
  "author": "Anonymous",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-c3-devkitm-1",
      "id": "esp32",
      "top": 0,
      "left": 0,
      "attrs": { "serialInterface": "USB_SERIAL_JTAG" }
    },
    { "type": "wokwi-mpu6050", "id": "imu", "top": -120, "left": -150, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo_pwm", "top": -130, "left": 120, "attrs": { "horn": "double" } },
    { "type": "chip-wokwi-fe-urt-1", "id": "adapter", "top": -200, "left": 280, "attrs": {} },
    { "type": "chip-wokwi-ttl-servo", "id": "servo1", "top": -200, "left": 480, "attrs": {} }
  ],
  "connections": [
    [ "esp32:GND.1", "imu:GND", "black", [ "v0" ] ],
    [ "esp32:3V3.1", "imu:VCC", "red", [ "v0" ] ],
    [ "esp32:8", "imu:SDA", "blue", [ "v0" ] ],
    [ "esp32:9", "imu:SCL", "yellow", [ "v0" ] ],

    [ "esp32:GND.2", "servo_pwm:GND", "black", [ "v0" ] ],
    [ "esp32:5V.1", "servo_pwm:V+", "red", [ "v0" ] ],
    [ "esp32:10", "servo_pwm:PWM", "orange", [ "v0" ] ],

    [ "esp32:TX", "adapter:TXD", "green", [ "v0" ] ],
    [ "esp32:RX", "adapter:RXD", "green", [ "v0" ] ],
    [ "adapter:DATA", "servo1:RX", "orange", [ "v0" ] ],
    [ "adapter:DATA", "servo1:TX", "orange", [ "v0" ] ],
    [ "esp32:GND.1", "adapter:GND", "black", [ "v0" ] ],
    [ "esp32:5V.1", "adapter:VCC", "red", [ "v0" ] ],
    [ "servo1:GND", "esp32:GND.1", "black", [ "v0" ] ],
    [ "servo1:VCC", "esp32:5V.1", "red", [ "v0" ] ]
  ],
  "dependencies": {},
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
